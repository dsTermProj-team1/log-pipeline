{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MSA Log Event",
  "description": "ott-msa 서비스가 Kafka로 발행하는 로그의 표준 스키마. log-pipeline의 모든 모듈은 이 스키마를 기준으로 파싱한다.",
  "type": "object",
  "required": ["timestamp", "service", "method", "uri", "status", "ip"],
  "properties": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 UTC"
    },
    "service": {
      "type": "string",
      "enum": ["auth", "content", "streaming"]
    },
    "method": {
      "type": "string",
      "enum": ["GET", "POST", "PUT", "DELETE", "PATCH"]
    },
    "uri": { "type": "string" },
    "status": { "type": "integer", "minimum": 100, "maximum": 599 },
    "ip": { "type": "string" },
    "user_id": { "type": ["string", "null"] },
    "has_valid_token": { "type": "boolean" },
    "latency_ms": { "type": "integer", "minimum": 0 },
    "user_agent": { "type": ["string", "null"] }
  }
}
