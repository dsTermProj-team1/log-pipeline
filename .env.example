# Kafka bootstrap (예: <kafka-cluster>-kafka-bootstrap.<namespace>.svc.cluster.local:9092)
KAFKA_BOOTSTRAP_SERVERS=<host>:<port>
KAFKA_TOPIC=<topic-name>
KAFKA_GROUP_ID=<consumer-group-id>

# HDFS namenode (예: hdfs://<namenode-host>.<namespace>.svc.cluster.local:8020)
HDFS_URI=hdfs://<host>:<port>
HDFS_BASE_PATH=/<path>
